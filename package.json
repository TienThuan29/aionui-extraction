{
  "name": "@aionui/ui",
  "version": "0.1.0",
  "description": "Reusable React UI components extracted from AionUi (Arco Design + icon-park)",
  "license": "Apache-2.0",
  "author": {
    "name": "AionUi",
    "email": "service@aionui.com"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "import": "./dist/markdown.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./styles.css": "./dist/styles.css",
    "./arco-theme.css": "./dist/arco-theme.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:watch": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "pretest": "bun run build",
    "test": "vitest run",
    "playground": "electron-vite dev --config playground/electron.vite.config.ts --entry playground/out/main/index.js",
    "playground:build": "electron-vite build --config playground/electron.vite.config.ts --entry playground/out/main/index.js",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "playground:pack": "bun run playground:build && electron-builder --config playground/electron-builder.yml",
    "docs:props": "bun scripts/gen-props.ts && oxfmt playground/docs/props.generated.json"
  },
  "dependencies": {
    "classnames": "^2.5.1"
  },
  "devDependencies": {
    "@arco-design/web-react": "^2.66.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@icon-park/react": "^1.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.1.6",
    "@types/react-syntax-highlighter": "^15.5.13",
    "diff2html": "^3.4.55",
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^28.1.0",
    "json5": "^2.2.3",
    "katex": "^0.16.22",
    "mermaid": "^11.13.0",
    "oxfmt": "0.41.0",
    "oxlint": "1.56.0",
    "postcss": "^8.5.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "typescript": "^5.8.3",
    "unocss": "^66.3.3",
    "unocss-preset-extra": "^1.0.0",
    "vite": "^6.4.1",
    "vitest": "^4.0.18",
    "wavedrom": "^3.6.2"
  },
  "peerDependencies": {
    "@arco-design/web-react": "^2.66.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@icon-park/react": "^1.4.2",
    "diff2html": "^3.4.55",
    "json5": "^2.2.3",
    "katex": "^0.16.22",
    "mermaid": "^11.13.0",
    "postcss": "^8.5.8",
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "wavedrom": "^3.6.2"
  },
  "peerDependenciesMeta": {
    "diff2html": {
      "optional": true
    },
    "json5": {
      "optional": true
    },
    "katex": {
      "optional": true
    },
    "mermaid": {
      "optional": true
    },
    "postcss": {
      "optional": true
    },
    "react-markdown": {
      "optional": true
    },
    "react-syntax-highlighter": {
      "optional": true
    },
    "rehype-katex": {
      "optional": true
    },
    "rehype-raw": {
      "optional": true
    },
    "rehype-sanitize": {
      "optional": true
    },
    "remark-breaks": {
      "optional": true
    },
    "remark-gfm": {
      "optional": true
    },
    "remark-math": {
      "optional": true
    },
    "wavedrom": {
      "optional": true
    }
  }
}
